{
  "name": "@getridian/mailbox",
  "version": "0.1.0-alpha.4",
  "description": "Email inboxes for AI agents: the Ridian TypeScript SDK for Node.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run build && npm test && npm run format:check",
    "format:check": "prettier --check src tests scripts *.json *.md .github/workflows/*.yml",
    "format": "prettier --write src tests scripts *.json *.md .github/workflows/*.yml",
    "pack:check": "node scripts/check-package.mjs"
  },
  "license": "MIT",
  "author": "PPJ Venture Labs UG (haftungsbeschränkt)",
  "homepage": "https://getridian.com/agent-mailbox/?utm_source=npm&utm_medium=referral&utm_campaign=typescript-sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getridian/ridian-mailbox-typescript.git"
  },
  "bugs": {
    "url": "https://github.com/getridian/ridian-mailbox-typescript/issues"
  },
  "keywords": [
    "ridian",
    "email",
    "inbox",
    "ai-agents",
    "typescript",
    "sdk",
    "webhooks"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "22.20.5",
    "prettier": "3.9.10"
  }
}
